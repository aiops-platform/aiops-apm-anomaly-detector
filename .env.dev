# aiops-apm-anomaly-detector 环境变量样例
# 复制为 .env 后按需修改；所有配置项均可被同名环境变量覆盖（前缀 APM_）。
# 配置加载见 src/aiops_apm/settings.py

# ---- 服务 ----
APM_HOST=0.0.0.0
APM_PORT=7070

# ---- 数据库（M2 起生效；M0 阶段仅为占位）----
APM_DB_HOST=127.0.0.1
APM_DB_PORT=3306
APM_DB_USER=root
APM_DB_PASSWORD=root123
APM_DB_NAME=aiops_apm_runtime

# ---- 调度器 ----
APM_SCHEDULER_TICK_SEC=1.0
APM_MAX_CONCURRENT_ROUNDS=10
APM_TOTAL_TIMEOUT_SEC=30.0

# ---- 出站（M3 起生效）----
APM_OUTBOUND_TIMEOUT_SEC=10.0
APM_OUTBOUND_MAX_BODY_BYTES=5000000

# ---- 开关 ----
APM_ENABLE_LLM_SUMMARY=false
APM_ENABLE_SCHEDULER=true
# mysql（生产） / memory（本地 demo/单测）
APM_STORAGE_BACKEND=mysql
