# aiops-apm-anomaly-detector 环境变量样例
# 复制为 .env 后按需修改；所有配置项均可被同名环境变量覆盖（前缀 APM_）。
# 配置加载见 src/aiops_apm/settings.py

# ---- 服务 ----
APM_HOST=0.0.0.0
APM_PORT=8080

# ---- 数据库（M2 起生效；M0 阶段仅为占位）----
APM_DB_HOST=127.0.0.1
APM_DB_PORT=3306
APM_DB_USER=root
APM_DB_PASSWORD=
APM_DB_NAME=aiops_apm_runtime

# ---- 调度器 ----
APM_SCHEDULER_TICK_SEC=1.0
APM_MAX_CONCURRENT_ROUNDS=10
APM_TOTAL_TIMEOUT_SEC=30.0

# ---- 出站（M3 起生效）----
APM_OUTBOUND_TIMEOUT_SEC=10.0
APM_OUTBOUND_MAX_BODY_BYTES=5000000
# agentflow（multi-agent-workflow / Bug Solve 后端）：Problem Center「Analyze」POST /run 用。
APM_BUG_SOLVE_BASE_URL=http://localhost:8000
# 诊断服务（HolmesGPT spike：aiops-agent-orchestration-spike）：Problem Center「分析new」
# 拼装 POST /diagnose/logs 用（同源读 GET /status/{session_id}）。
APM_DIAGNOSE_BASE_URL=http://localhost:8017
# 诊断请求的 repo 定位（spike 侧 repo 即仓库定位）。problem_record 无 repo 字段 →
# 缺省用本项；仍为空则回退 record.service。
APM_DIAGNOSE_REPO=

# ---- 开关 ----
APM_ENABLE_LLM_SUMMARY=false
APM_ENABLE_SCHEDULER=true
# mysql（生产） / memory（本地 demo/单测）
APM_STORAGE_BACKEND=mysql

APM_ENABLE_RECONCILER=false